@model LanBasedHelpDeskTickingSystem.Entities.DTOs.RegisterDto
@{
    ViewData["Title"] = "Register Page";
}

<section class="relative min-h-screen flex items-center justify-center bg-gray-900">
    
    <div class="absolute inset-0 z-0">
            <img src="http://localhost:5194/images/bg_1.jpg" alt="Background" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]"></div>
        </div>
    
    <div class="relative z-10 w-full max-w-md bg-white/95 backdrop-blur-xl shadow-2xl rounded-2xl p-8 border border-white/20">
        @* <h1 class="text-2xl font-bold text-center text-gray-800 mb-6"> *@
        @*     Sign in to your account *@
        @* </h1> *@
        
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Create Account</h1>
            <p class="text-gray-500 text-sm mt-2">Please provide your information to register</p>
        </div>

        <form id="registerForm" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Username</label>
                <input
                    asp-for="Username"
                    type="text"
                    class="bg-gray-50 border border-gray-300 text-gray-500 text-sm rounded-lg focus:ring-blue-500 focus:text-gray-900 focus:border-blue-500 disabled:opacity-30 block w-full p-2.5 mt-1"
                    placeholder="Enter your username"/>
                <p id="error-username" class="mt-2 text-sm text-red-600 dark:text-red-500"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Email</label>
                <input
                    asp-for="Email"
                    type="email"
                    class="bg-gray-50 border border-gray-300 text-gray-500 text-sm rounded-lg focus:ring-blue-500 focus:text-gray-900 focus:border-blue-500 disabled:opacity-30 block w-full p-2.5 mt-1"
                    placeholder="Enter your email"/>
                <p id="error-email" class="mt-2 text-sm text-red-600 dark:text-red-500"></p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Password</label>
                <input asp-for="Password" type="password"
                       class="bg-gray-50 border border-gray-300 text-gray-500 text-sm rounded-lg focus:ring-blue-500 disabled:opacity-30 focus:text-gray-900  
                        focus:border-blue-500 block w-full p-2.5 mt-1" placeholder="Enter your password"/>
                <p id="error-password" class="mt-2 text-sm text-red-600 dark:text-red-500"></p>

            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Retype Password</label>
                <input asp-for="RetypePassword" type="password"
                       class="bg-gray-50 border border-gray-300 text-gray-500 text-sm rounded-lg focus:ring-blue-500 disabled:opacity-30 focus:text-gray-900  
                        focus:border-blue-500 block w-full p-2.5 mt-1" placeholder="Repeat your password"/>
                <p id="error-retypepassword" class="mt-2 text-sm text-red-600 dark:text-red-500"></p>

            </div>

            <button id="btn" type="submit"
                    class="w-full text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none 
                    focus:ring-blue-300 disabled:bg-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                Register
            </button>

            <div class="flex items-center justify-center">
                <span class="text-gray-500 text-sm">or</span>
            </div>

            <a href="/api/auth/login/google"
               class="flex items-center justify-center w-full border border-gray-200 text-gray-700 
                    bg-white hover:bg-gray-50 focus:ring-4 focus:outline-none focus:ring-gray-100 
                    font-medium rounded-lg text-sm px-5 py-2.5 text-center transition-all shadow-sm hover:shadow-md">
                <svg class="w-5 h-5 mr-2" viewBox="0 0 48 48">
                    <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"></path><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"></path><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"></path><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"></path>
                </svg>
                Google
            </a>

            <p class="text-sm text-center text-gray-500 mt-4">
                Already have an account?
                <a asp-controller="Auth" asp-action="Login" class="text-blue-600 hover:underline">Login</a>
            </p>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/actions/auth.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const input_username = document.getElementById("Username");
            const input_email = document.getElementById("Email");
            const input_password = document.getElementById("Password");
            const retype_password = document.getElementById("RetypePassword");
            
            document.getElementById("registerForm").addEventListener("submit", async function (e) {
                e.preventDefault();
               
                
                const formData = {
                    Username: input_username.value,
                    Email: input_email.value,
                    Password: input_password.value,
                    RetypePassword: retype_password.value
                };
                
                console.log(formData)
                
                await authForm("registerForm", "btn", formData, "/api/auth/register", () => {
                    input_username.disabled = false;
                    input_email.disabled = false;
                    input_password.disabled = false;
                    retype_password.disabled = false;
                });
            });
           
        });
    </script>
}
