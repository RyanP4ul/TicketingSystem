@model LanBasedHelpDeskTickingSystem.Entities.DTOs.LoginDto
@{
    ViewData["Title"] = "Home Page";
}

<section class="relative min-h-screen flex items-center justify-center bg-gray-900">
    
    <div class="absolute inset-0 z-0">
        <img src="http://localhost:5194/images/bg_1.jpg" alt="Background" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]"></div>
    </div>

    <div class="relative z-10 w-full max-w-md bg-white/95 backdrop-blur-xl shadow-2xl rounded-2xl p-8 border border-white/20">
        
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Welcome Back</h1>
            <p class="text-gray-500 text-sm mt-2">Sign in to access your account</p>
        </div>

        <form id="loginForm" class="space-y-5">
            
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </div>
                    <input
                        asp-for="UsernameOrEmail"
                        type="text"
                        class="pl-10 bg-gray-50 border border-gray-300 text-gray-500 focus:text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 transition-colors"
                        placeholder="Enter your email"/>
                </div>
                <p id="error-usernameoremail" class="mt-1 text-xs text-red-600"></p>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Password</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                    <input asp-for="Password" type="password"
                           class="pl-10 bg-gray-50 border border-gray-300 text-gray-500 focus:text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 transition-colors" 
                           placeholder="Enter your password"/>
                </div>
                <p id="error-password" class="mt-1 text-xs text-red-600"></p>
                @* <div class="flex justify-end mt-1"> *@
                @*     <a href="#" class="text-xs text-blue-600 hover:underline">Forgot password?</a> *@
                @* </div> *@
            </div>

            <button id="btn" type="submit"
                    class="w-full text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-3 text-center shadow-lg shadow-blue-500/30 transition-all transform hover:-translate-y-0.5">
                Sign In
            </button>

            <div class="relative flex items-center py-2">
                <div class="flex-grow border-t border-gray-300"></div>
                <span class="flex-shrink-0 mx-4 text-gray-400 text-xs uppercase tracking-wider">Or continue with</span>
                <div class="flex-grow border-t border-gray-300"></div>
            </div>

            <a href="/api/auth/login/google"
               class="flex items-center justify-center w-full border border-gray-200 text-gray-700 
                    bg-white hover:bg-gray-50 focus:ring-4 focus:outline-none focus:ring-gray-100 
                    font-medium rounded-lg text-sm px-5 py-2.5 text-center transition-all shadow-sm hover:shadow-md">
                <svg class="w-5 h-5 mr-2" viewBox="0 0 48 48">
                    <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"></path><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"></path><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"></path><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"></path>
                </svg>
                Google
            </a>

            <p class="text-sm text-center text-gray-500 mt-6">
                Don’t have an account?
                <a asp-controller="Auth" asp-action="Register" class="font-semibold text-blue-600 hover:text-blue-700 hover:underline">Create one</a>
            </p>
        </form>
    </div>
</section>

