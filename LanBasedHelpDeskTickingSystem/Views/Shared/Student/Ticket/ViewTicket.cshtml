@using LanBasedHelpDeskTickingSystem.Data
@using LanBasedHelpDeskTickingSystem.Entities.Models
@model LanBasedHelpDeskTickingSystem.Entities.DTOs.ViewTicketDto
@{
    ViewData["Title"] = "View Ticket Tickets";
    const string modelConfirm = "confirm-article-modal";
}

<div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>


@await Html.PartialAsync("_Navbar")

<div class="p-4 sm:ml-64">
    <div class="mt-14">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6">
            <div>
                <div class="flex items-center gap-3 mb-1">
                    <h1 class="text-3xl font-bold text-gray-900">@ViewBag.Ticket.Title</h1>
                    <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded border border-yellow-300">Open</span>
                </div>
                <p class="text-sm text-gray-500">Ticket <span class="font-mono text-gray-700 font-bold">#@ViewBag.Ticket.TicketNumber</span></p>
            </div>
        </div>
        
        <form id="form" data-id="@ViewBag.Ticket.Id">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2 space-y-6">
                    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
                        <h2 class="text-lg font-semibold text-gray-900 mb-4">Description</h2>
                        <div class="w-full mb-4 border border-gray-200 rounded-lg bg-gray-50">
                            <div class="px-4 py-2 bg-white rounded-t-lg">
                                <label for="comment" class="sr-only">Description</label>
                                <textarea id="Description" name="Description" rows="6" class="w-full px-0 text-sm text-gray-900 bg-white border-0 focus:ring-0" placeholder="Write a description...">@ViewBag.Ticket.Description</textarea>
                            </div>
                            <div class="flex items-center justify-between px-3 py-2 border-t border-gray-200">
                                <div class="flex pl-0 space-x-1 sm:pl-2">
                                    <button type="button" class="inline-flex justify-center items-center p-2 text-gray-500 rounded cursor-pointer hover:text-gray-900 hover:bg-gray-100">
                                        <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 12 20">
                                            <path stroke="currentColor" stroke-linejoin="round" stroke-width="2" d="M1 6v8a5 5 0 1 0 10 0V4.5a3.5 3.5 0 1 0-7 0V13a2 2 0 0 0 4 0V6"/>
                                        </svg>
                                        <span class="sr-only">Attach file</span>
                                    </button>
                                </div>
                                <div class="text-xs text-gray-400">Markdown supported</div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
                        <h2 class="text-lg font-semibold text-gray-900 mb-4">Attachments</h2>
                        <p class="text-sm font-medium text-gray-700 mb-2">Attached Images (Click to enlarge):</p>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

                            @foreach (Attachment attachment in ViewBag.Ticket.Attachments)
                            {
                                <div class="relative group">
                                    <img
                                        src="/Uploads/@attachment.FileName.@attachment.FileExtension"
                                        class="h-64 w-full object-cover rounded-lg cursor-zoom-in hover:opacity-90 transition-opacity"
                                        alt="Ticket Attachment"
                                        onclick="openZoom(this)"/>

                                    <button
                                        type="button"
                                        id="remove-attachment"
                                        data-id="@attachment.id"
                                        class="absolute top-2 right-2 bg-red-600 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity">
                                        Remove
                                    </button>
                                </div>
                            }
                        </div>

                        <div class="flex items-center justify-center w-full">
                            <label for="dropzone-file" class="flex flex-col items-center justify-center w-full h-32 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 transition-colors">
                                <div class="flex flex-col items-center justify-center pt-5 pb-6">
                                    <svg class="w-8 h-8 mb-4 text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2"/>
                                    </svg>
                                    <p class="mb-2 text-sm text-gray-500"><span class="font-semibold">Click to upload</span> or drag and drop</p>
                                    <p class="text-xs text-gray-500">SVG, PNG, JPG or PDF (MAX. 5MB)</p>
                                </div>
                                <input asp-for="Files" type="file" class="hidden" multiple/>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="space-y-6">
                    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-5">
                        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4">Properties</h3>
                        <div class="space-y-4">
                            <div>
                                <label for="Title" class="block mb-2 text-sm font-medium text-gray-900">Title</label>
                                <input
                                    asp-for="Title"
                                    type="text"
                                    class="bg-gray-50 border border-gray-300 text-gray-800 text-sm rounded-lg focus:ring-blue-500 focus:text-gray-900 focus:border-blue-500 disabled:opacity-30 block w-full p-2.5 mt-1"
                                    placeholder="Enter title"
                                    value="@ViewBag.Ticket.Title"/>
                                <p id="error-title" class="mt-2 text-sm text-red-600 dark:text-red-500"></p>
                            </div>
                            <div>
                                <label for="CategoryId" class="block mb-2 text-sm font-medium text-gray-900">Category</label>
                                <select asp-for="CategoryId" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5">
                                    @foreach (var category in ViewBag.Categories)
                                    {
                                        if (category.Id == ViewBag.Ticket.CategoryId)
                                        {
                                            <option value="@category.Id" selected>@category.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div>
                                <label for="Priority" class="block mb-2 text-sm font-medium text-gray-900">Priority</label>
                                <select asp-for="Priority" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5">
                                    @foreach (var priority in new string[] { "Low", "Medium", "High" })
                                    {
                                        if (ViewBag.Ticket.Priority == priority.ToLower())
                                        {
                                            <option value="@priority.ToLower()" selected>@priority</option>
                                        }
                                        else
                                        {
                                            <option value="@priority.ToLower()">@priority</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div>
                                <label for="Room" class="block mb-2 text-sm font-medium text-gray-900">Room / Location</label>
                                <select asp-for="Room" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5">
                                    <option value="none" selected>None</option>
                                    @foreach (var room in Rooms.RoomList)
                                    {
                                        <option value="@room">@room</option>
                                    }
                                </select>
                                <p class="text-gray-500 text-xs">Optional but recommended</p>
                            </div>
                        </div>

                        <hr class="h-px my-5 bg-gray-200 border-0">

                        <div class="space-y-3">
                            <div>
                                <span class="block text-xs font-medium text-gray-500 uppercase">Created</span>
                                <span class="text-sm text-gray-900 flex items-center gap-2">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    @ViewBag.Ticket.CreatedAt
                                </span>
                            </div>
                            <div>
                                <span class="block text-xs font-medium text-gray-500 uppercase">Last Updated</span>
                                <span class="text-sm text-gray-900 flex items-center gap-2">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    @ViewBag.Ticket.UpdatedAt
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-5">
                        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4">Actions</h3>
                        <div class="flex flex-col gap-3">
                            <button id="update-ticket-button" type="submit" class="w-full text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 focus:outline-none flex items-center justify-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
                                </svg>
                                Update Ticket
                            </button>
                            <button type="button" class="confirm-btn w-full text-red-700 hover:text-white border border-red-700 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center flex items-center justify-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                                Remove Ticket
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <div id="zoom-overlay"
             class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-sm flex justify-center items-center opacity-0 transition-opacity duration-300 ease-out"
             onclick="closeZoom()">

            <button class="absolute top-5 right-5 text-white text-4xl font-bold hover:text-gray-300 focus:outline-none" onclick="closeZoom()">&times;</button>

            <img id="zoomed-image"
                 src=""
                 alt="Zoomed Content"
                 class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl transform scale-95 transition-transform duration-300"
                 onclick="event.stopPropagation()"/>
        </div>

    </div>
</div>

@section Scripts
{
    <script src="~/js/libs/toast.js" asp-append-version="true"></script>
    <script src="~/js/user/view-ticket.js" asp-append-version="true"></script>
}