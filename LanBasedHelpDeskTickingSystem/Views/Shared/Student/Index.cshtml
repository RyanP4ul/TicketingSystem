@using LanBasedHelpDeskTickingSystem.Utils
@model LanBasedHelpDeskTickingSystem.Entities.Views.UserDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}

@await Html.PartialAsync("_Navbar")

<div class="p-4 sm:ml-64">
<div class="mt-14">
<section class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
            Welcome back, @User.Identity?.Name
        </h1>
        <p class="text-lg text-gray-500 dark:text-gray-400">
            Here's an overview of your support tickets and quick actions.
        </p>
    </div>
    <a asp-area="User" asp-controller="Ticket" asp-action="Index" class="inline-flex items-center text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
        <svg class="w-4 h-4 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h14M8 5l7 5-7 5"/>
        </svg>
        Manage All Tickets
    </a>
</section>

<section class="mb-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
    <div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
        <div class="flex justify-between items-start">
            <div>
                <h5 class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase">Total Tickets</h5>
                <span class="text-4xl font-bold text-gray-900 dark:text-white">@Model.TotalTickets</span>
            </div>
            <div class="p-3 bg-blue-100 dark:bg-blue-900 rounded-full">
                <svg class="w-6 h-6 text-blue-600 dark:text-blue-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 20">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1v18h14V1H1Zm8 12.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z"/>
                </svg>
            </div>
        </div>
    </div>
    <div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
        <div class="flex justify-between items-start">
            <div>
                <h5 class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase">Pending</h5>
                <span class="text-4xl font-bold text-gray-900 dark:text-white">@Model.PendingTickets</span>
            </div>
            <div class="p-3 bg-yellow-100 dark:bg-yellow-900 rounded-full">
                <svg class="w-6 h-6 text-yellow-600 dark:text-yellow-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6v4l3.276 3.276M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                </svg>
            </div>
        </div>
    </div>
    <div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
        <div class="flex justify-between items-start">
            <div>
                <h5 class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase">In Progress</h5>
                <span class="text-4xl font-bold text-gray-900 dark:text-white">@Model.PendingTickets</span>
            </div>
            <div class="p-3 bg-cyan-100 dark:bg-cyan-900 rounded-full">
                <svg class="w-6 h-6 text-cyan-600 dark:text-cyan-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11V6m0 8h.01M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                </svg>
            </div>
        </div>
    </div>
    <div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
        <div class="flex justify-between items-start">
            <div>
                <h5 class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase">Resolved</h5>
                <span class="text-4xl font-bold text-gray-900 dark:text-white">@Model.ResolvedTickets</span>
            </div>
            <div class="p-3 bg-green-100 dark:bg-green-900 rounded-full">
                <svg class="w-6 h-6 text-green-600 dark:text-green-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 12">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5.917 5.724 10.642 14.55 1.813"/>
                </svg>
            </div>
        </div>
    </div>
    <div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
        <div class="flex justify-between items-start">
            <div>
                <h5 class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase">Closed</h5>
                <span class="text-4xl font-bold text-gray-900 dark:text-white">@Model.ClosedTickets</span>
            </div>
            <div class="p-3 bg-red-100 dark:bg-red-900 rounded-full">
                <svg class="w-6 h-6 text-red-600 dark:text-red-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
            </div>
        </div>
    </div>
</section>

<section class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <div class="lg:col-span-2">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Recent Tickets</h2>
            <a asp-area="User" asp-controller="Ticket" asp-action="Index" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-500">
                View All
            </a>
        </div>

        <div class="flex flex-col gap-6">

            @if (Model.Tickets.Any())
            {
                @foreach (var recentTicket in Model.Tickets)
                {
                    <div class="p-6 bg-white rounded-lg shadow border border-gray-200 dark:bg-gray-800 dark:border-gray-700">
                        <div class="flex justify-between items-start mb-3">
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                                @recentTicket.Title
                            </h3>
                            @Html.Raw(BadgeHelper.GetStatusBadge(recentTicket.Status))
                        </div>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                            @recentTicket.Description
                        </p>
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                            <div class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M10 0a10 10 0 1 0 10 10A10.011 10.011 0 0 0 10 0Zm0 5a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm0 13a8.949 8.949 0 0 1-4.951-1.488A3.987 3.987 0 0 1 9 13h2a3.987 3.987 0 0 1 3.951 3.512A8.949 8.949 0 0 1 10 18Z"/>
                                </svg>
                                <span class="text-sm font-medium text-gray-500 dark:text-gray-400">@recentTicket.Requester?.Email</span>
                                <span class="text-sm text-gray-500 dark:text-gray-400">· @recentTicket.CreatedAt</span>
                            </div>
                            <a asp-area="User" asp-controller="Ticket" asp-action="ViewTicket" asp-route-id="@recentTicket.Id" class="inline-flex items-center text-sm font-medium text-blue-600 hover:underline dark:text-blue-500">
                                View Details
                                <svg class="w-3 h-3 ml-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-gray-500">No recent tickets available.</p>
            }
        </div>
    </div>

    <div>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Quick Actions</h2>

        <div class="w-full bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
            <ul class="divide-y divide-gray-200 dark:divide-gray-700">
                <li class="p-4 sm:py-5 sm:px-6 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <a asp-area="User" asp-controller="Ticket" asp-action="NewTicket" class="flex items-center space-x-4 rtl:space-x-reverse">
                        <div class="flex-shrink-0 p-3 bg-blue-100 dark:bg-blue-900 rounded-full">
                            <svg class="w-6 h-6 text-blue-700 dark:text-blue-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 5.757v8.486M5.757 10h8.486M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-md font-semibold text-gray-900 truncate dark:text-white">
                                Submit new ticket
                            </p>
                            <p class="text-sm text-gray-500 truncate dark:text-gray-400">
                                Report an issue or request help
                            </p>
                        </div>
                        <div class="inline-flex items-center text-base font-semibold text-gray-900 dark:text-white">
                            <svg class="w-4 h-4 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
                            </svg>
                        </div>
                    </a>
                </li>
                <li class="p-4 sm:py-5 sm:px-6 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <a asp-area="User" asp-controller="KnowledgeBase" asp-action="Index" class="flex items-center space-x-4 rtl:space-x-reverse">
                        <div class="flex-shrink-0 p-3 bg-green-100 dark:bg-green-900 rounded-full">
                            <svg class="w-6 h-6 text-green-700 dark:text-green-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 1_3h4l3 3v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h2.172a2 2 0 0 1 1.414.586L9 3Zm3 9L9 9m0 0L7 7m2 2L7 9m2 2h2m-2 2h2m-2 2h2M3 3h2M3 6h2m-2 3h2m-2 3h2m-2 3h2"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-md font-semibold text-gray-900 truncate dark:text-white">
                                Browse Help Articles
                            </p>
                            <p class="text-sm text-gray-500 truncate dark:text-gray-400">
                                Find solutions in our knowledge base
                            </p>
                        </div>
                        <div class="inline-flex items-center text-base font-semibold text-gray-900 dark:text-white">
                            <svg class="w-4 h-4 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
                            </svg>
                        </div>
                    </a>
                </li>
                <li class="p-4 sm:py-5 sm:px-6 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-b-lg">
                    <a href="#" class="flex items-center space-x-4 rtl:space-x-reverse">
                        <div class="flex-shrink-0 p-3 bg-gray-100 dark:bg-gray-900 rounded-full">
                            <svg class="w-6 h-6 text-gray-700 dark:text-gray-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 18">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm0 0v10M5.002 8.772V18M9 8.772V18"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-md font-semibold text-gray-900 truncate dark:text-white">
                                My Profile
                            </p>
                            <p class="text-sm text-gray-500 truncate dark:text-gray-400">
                                View your account details
                            </p>
                        </div>
                        <div class="inline-flex items-center text-base font-semibold text-gray-900 dark:text-white">
                            <svg class="w-4 h-4 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
                            </svg>
                        </div>
                    </a>
                </li>
            </ul>
        </div>

    </div>
</section>


@await Html.PartialAsync("_Footer")

</div>
</div>

@await Html.PartialAsync("_AiChatSupport")

@section Scripts
{
    <script src="~/js/ai-chat-support.js" asp-append-version="true"></script>
}
