@model LanBasedHelpDeskTickingSystem.Entities.Models.KnowledgeBase
@{
    ViewData["Title"] = "KnowledgeBase";
}

@await Html.PartialAsync("_Navbar")

<div class="p-4 sm:ml-64">
    <div class="mt-14">
        <a asp-area="User" asp-action="Index" asp-controller="KnowledgeBase" class="flex items-center text-sm font-medium text-blue-600 hover:underline mb-4">
            <svg class="w-4 h-4 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5H1m0 0l4-4M1 5l4 4"/>
            </svg>
            Back to all knowledge base
        </a>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                
                <div class="lg:col-span-2">
                    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8 rounded-lg">
                        
                        <header class="mb-8 border-b border-gray-100 pb-8">
                            <div class="flex items-center gap-3 mb-4">
                                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded">@Model.Category?.Name</span>
                                <span class="text-gray-400 text-xs">Updated Nov 15, 2025</span>
                            </div>
                            <h1 class="text-3xl font-bold text-gray-900 mb-4">@Model.Title</h1>
                        </header>
        
                        <article class="prose prose-slate max-w-none text-gray-600">
                            <p class="mb-6 text-lg leading-relaxed">
                                @Html.Raw(Model.Content)
                            </p>
        
                        </article>
        
                        @* <div class="mt-12 pt-8 border-t border-gray-100"> *@
