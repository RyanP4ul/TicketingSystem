                        @*             <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path></svg> *@
                        @*             Yes, thanks *@
                        @*         </button> *@
                        @*         <button class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-red-700 focus:z-10 focus:ring-2 focus:ring-red-700 focus:text-red-700"> *@
                        @*             <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.095c.5 0 .905-.405.905-.905 0-.714.211-1.412.608-2.006L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"></path></svg> *@
                        @*             Not really *@
                        @*         </button> *@
                        @*     </div> *@
                        @* </div> *@
                    </div>
                </div>
        
                <div class="lg:col-span-1 space-y-6">
                    
                    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
                        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4">Related Articles</h3>
                        <ul class="space-y-3">
                            <li>
                                <a href="#" class="block group">
                                    <span class="block text-sm font-medium text-gray-700 group-hover:text-blue-600 transition-colors">Reset ELMS Password</span>
                                    <span class="text-xs text-gray-400">Account • 1 min read</span>
                                </a>
                            </li>
                            <hr class="border-gray-100">
                            <li>
                                <a href="#" class="block group">
                                    <span class="block text-sm font-medium text-gray-700 group-hover:text-blue-600 transition-colors">Accessing Library Database</span>
                                    <span class="text-xs text-gray-400">Academic • 3 min read</span>
                                </a>
                            </li>
                            <hr class="border-gray-100">
                            <li>
                                <a href="#" class="block group">
                                    <span class="block text-sm font-medium text-gray-700 group-hover:text-blue-600 transition-colors">VPN Setup for Home</span>
                                    <span class="text-xs text-gray-400">Network • 5 min read</span>
                                </a>
                            </li>
                        </ul>
                    </div>
        
                    @* <div class="p-6 bg-blue-600 rounded-xl shadow-sm text-white"> *@
                    @*     <h3 class="text-lg font-bold mb-2">Still stuck?</h3> *@
                    @*     <p class="text-blue-100 text-sm mb-4">If you can't connect after trying these steps, submit a ticket.</p> *@
                    @*     <button class="w-full py-2 px-4 bg-white text-blue-700 font-semibold rounded-lg text-sm hover:bg-blue-50 transition-colors"> *@
                    @*         Create Support Ticket *@
                    @*     </button> *@
                    @* </div> *@
        
                </div>
            </div>
            
            @await Html.PartialAsync("_Footer")
            
    </div>
</div>

@await Html.PartialAsync("_AiChatSupport")

@section Scripts {
    <script src="~/js/ai-chat-support.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById("content").innerHTML = `@Html.Raw(Model.Content)`;
        });
    </script>
}