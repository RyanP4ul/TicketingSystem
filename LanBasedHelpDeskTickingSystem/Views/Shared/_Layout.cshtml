<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - TickingSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <script src="~/js/notification.js" asp-append-version="true"></script>
</head>
<body class="bg-gray-100 dark:bg-gray-900 font-sans">

<style>
    .apexcharts-legend-text {
        display: inline-block !important;
        visibility: visible !important;
        opacity: 1 !important;
        
        color: #374151 !important; 
        fill: #374151 !important;
        
        margin-left: 5px !important;
    }

    .dark .apexcharts-legend-text {
        color: #9CA3AF !important;
        fill: #9CA3AF !important;
    }
</style>

<header>
    @if (User.Identity.IsAuthenticated)
    {
        @await Component.InvokeAsync("Header")
    }
</header>

@RenderBody()

<script src="~/js/flowbite/flowbite.min.js" asp-append-version="true"></script>
<script src="~/js/apexcharts/apexcharts.min.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const totalOpenTickets = document.getElementById("total-open-tickets");
        if (totalOpenTickets) {
            fetch('/api/admin/tickets/total')
                .then(response => response.json())
                .then(res => {
                    totalOpenTickets.textContent = res.data;
                })
                .catch(error => {
                    totalOpenTickets.textContent = "0";
                });
        }
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>