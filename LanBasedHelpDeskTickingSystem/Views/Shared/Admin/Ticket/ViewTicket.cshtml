@using LanBasedHelpDeskTickingSystem.Entities.Models
@model LanBasedHelpDeskTickingSystem.Entities.Views.AdminTicketViewModel
@{
    ViewData["Title"] = "View Ticket Tickets";
    var isNotAvailable = Model.Ticket.Status == "resolved" || Model.Ticket.Status == "close";
}

<div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

@await Html.PartialAsync("_Navbar")

<div class="p-4 sm:ml-64">
    <div class="mt-14">
    <a asp-action="Index" asp-controller="Ticket" class="flex items-center text-sm font-medium text-blue-600 hover:underline mb-4">
        <svg class="w-4 h-4 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5H1m0 0l4-4M1 5l4 4"/>
        </svg>
        Back to all tickets
    </a>
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">Ticket #@Model.Ticket.TicketNumber</h1>
            <p class="text-lg text-gray-500 mt-1">@Model.Ticket.Title</p>
        </div>
        <div class="flex-shrink-0 flex items-center gap-2">
            <span class="inline-flex items-center bg-blue-100 text-blue-800 text-sm font-medium px-3 py-1 rounded-full">
                <span class="w-2 h-2 me-1.5 bg-blue-500 rounded-full"></span>
                Open
            </span>
            <span class="inline-flex items-center bg-red-100 text-red-800 text-sm font-medium px-3 py-1 rounded-full">
                <span class="w-2 h-2 me-1.5 bg-red-500 rounded-full"></span>
                Low
            </span>
        </div>
    </div>
    
    @if (Model.Ticket.Status == "resolved" || Model.Ticket.Status == "close")
    {
        <div class="flex items-center p-4 mb-4 text-sm text-yellow-800 rounded-lg bg-yellow-50 dark:bg-gray-800 dark:text-yellow-300" role="alert">
            <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
            </svg>
            <span class="sr-only">Info</span>
            <div>
                <span class="font-medium">Warning!</span> This ticket is marked as @Model.Ticket.Status. No further actions can be taken.
            </div>
        </div>
    }
    
    @if (Model.Ticket.Assigned != null && Model.Ticket.Assigned.Username != User.Identity?.Name)
    {
        <div class="flex items-center p-4 mb-4 text-sm text-yellow-800 rounded-lg bg-yellow-50 dark:bg-gray-800 dark:text-yellow-300" role="alert">
            <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
            </svg>
            <span class="sr-only">Info</span>
            <div>
                <span class="font-medium">Warning!</span> This ticket is currently assigned to <strong>@Model.Ticket.Assigned.Username</strong>. Please contact them for further updates.
            </div>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 flex flex-col gap-6">
            <div class="bg-white rounded-lg shadow-md p-6">
                <div class="flex items-center gap-3 mb-4">
                    <img class="w-10 h-10 rounded-full" src="https://placehold.co/100x100/e2e8f0/cbd5e1?text=RP" alt="User avatar">
                    <div>
                        <span class="font-semibold text-gray-900">@Model.Ticket.Requester?.Username</span>
                        <span class="text-gray-500 text-sm"> created this ticket</span>
                    </div>
                </div>

                <div class="prose prose-sm max-w-none text-gray-700">
                    <p>@Model.Ticket.Description</p>
                </div>

                <div class="mt-4 pt-4 border-t border-gray-200">
                    <h4 class="text-sm font-medium text-gray-500 mb-2">Room / Location</h4>
                    <p class="text-sm font-semibold text-gray-800">Science Wing - Room 204</p>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Attachments</h2>
                <p class="text-sm font-medium text-gray-700 mb-2">Attached Images (Click to enlarge):</p>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    @foreach (Attachment attachment in Model.Ticket.Attachments)
                    {
                        <div class="relative group">
                            <img
                                src="/Uploads/@attachment.FileName.@attachment.FileExtension"
                                class="h-64 w-full object-cover rounded-lg cursor-zoom-in hover:opacity-90 transition-opacity"
                                alt="Ticket Attachment"
                                onclick="openZoom(this)"/>
                        </div>
                    }
                </div>
                @* <div class="grid grid-cols-2 md:grid-cols-4 gap-4"> *@
                @*     <a href="#" class="image-thumbnail" data-modal-target="image-modal" data-modal-toggle="image-modal"> *@
                @*         <img src="https://placehold.co/600x400/e2e8f0/cbd5e1?text=Projector+View" alt="Attachment preview" class="rounded-lg w-full h-24 object-cover cursor-pointer hover:opacity-80 transition-opacity"> *@
                @*     </a> *@
                @*     <a href="#" class="image-thumbnail" data-modal-target="image-modal" data-modal-toggle="image-modal"> *@
                @*         <img src="https://placehold.co/600x400/34d399/10b981?text=Green+Screen" alt="Attachment preview" class="rounded-lg w-full h-24 object-cover cursor-pointer hover:opacity-80 transition-opacity"> *@
                @*     </a> *@
                @*     <a href="#" class="image-thumbnail" data-modal-target="image-modal" data-modal-toggle="image-modal"> *@
                @*         <img src="https://placehold.co/600x400/f87171/b91c1c?text=Error+Message" alt="Attachment preview" class="rounded-lg w-full h-24 object-cover cursor-pointer hover:opacity-80 transition-opacity"> *@
                @*     </a> *@
                @* </div> *@
            </div>

            <div class="bg-white rounded-lg shadow-md">
                <div class="p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">Communication Feed</h2>

                    <div class="space-y-6">
                        <div class="flex gap-3">
                            <img class="w-10 h-10 rounded-full" src="https://placehold.co/100x100/dbeafe/3b82f6?text=A" alt="Admin avatar">
                            <div class="flex-1 bg-blue-50 border border-blue-200 rounded-lg p-4">
                                <div class="flex items-center justify-between mb-1">
                                    <div class="font-semibold text-gray-900">
                                        Admin User
                                        <span class="ml-2 bg-blue-100 text-blue-800 text-xs font-medium px-2 py-0.5 rounded">Admin</span>
                                    </div>
                                    <span class="text-xs text-gray-500">1 hour ago</span>
                                </div>
                                <p class="text-sm text-gray-700">Assigned to myself. Will check the projector settings in SCI-204 this afternoon.</p>
                            </div>
                        </div>

                        <div class="flex gap-3">
                            <img class="w-10 h-10 rounded-full" src="https://placehold.co/100x100/e2e8f0/cbd5e1?text=RP" alt="User avatar">
                            <div class="flex-1 bg-gray-50 border border-gray-200 rounded-lg p-4">
                                <div class="flex items-center justify-between mb-1">
                                    <span class="font-semibold text-gray-900">ryanpaul2028</span>
                                    <span class="text-xs text-gray-500">2 hours ago</span>
                                </div>
                                <p class="text-sm text-gray-700">Just to add, I also tried restarting the computer, but it didn't help.</p>
                            </div>
                        </div>

                        <div id="no-comments" class="text-center text-gray-500 py-4 hidden">
                            No comments yet.
                        </div>
                    </div>
                </div>

                <form class="p-6 border-t border-gray-200 bg-gray-50 rounded-b-lg">
                    <div class="mb-4">
                        <label for="comment" class="block mb-2 text-sm font-medium text-gray-700">Add Comment</label>
                        <textarea id="comment" rows="4" class="block p-2.5 w-full text-sm text-gray-900 bg-white rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500" placeholder="Type your message here..."></textarea>
                    </div>
                    <div class="flex items-center justify-between">
                        <button type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5">
                            Add Comment
                        </button>
                        <div class="flex items-center">
                            <input id="internal-note" type="checkbox" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500">
                            <label for="internal-note" class="ms-2 text-sm font-medium text-gray-600">Add as internal note</label>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="lg:col-span-1 flex flex-col gap-6">

            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Ticket Management</h2>
                <form class="space-y-4">
                    <div>
                        <label for="select-status" class="block mb-2 text-sm font-medium text-gray-700">Status</label>
                        <select id="select-status" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                            <option value="open" selected>Open</option>
                            <option value="in_progress">In Progress</option>
                            <option value="resolved">Resolved</option>
                            <option value="closed">Closed</option>
                        </select>
                    </div>

                    <div>
                        <label for="select-assigned-to" class="block mb-2 text-sm font-medium text-gray-700">Assigned To</label>
                        <select id="select-assigned-to" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                            @foreach (var user in Model.Users)
                            {
                                if (Model.Ticket.AssignedId == user.Id)
                                {
                                    <option value="@user.Id" selected>@user.Username</option>
                                }
                                else
                                {
                                    <option value="@user.Id">@user.Username</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="flex flex-col space-y-2 pt-2">
                        <button id="update-ticket-btn" data-id="@Model.Ticket.Id" type="submit" class="w-full text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5">
                            Update Ticket
                        </button>
                        <button id="reject-ticket-btn" type="button" class="w-full text-white bg-red-600 hover:bg-red-700 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5">
                            Reject Ticket
                        </button>
                    </div>
                </form>
            </div>

            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">Details</h2>
                <dl class="divide-y divide-gray-200">
                    <div class="py-3 grid grid-cols-3 gap-4">
                        <dt class="text-sm font-medium text-gray-500 col-span-1">Category</dt>
                        <dd class="text-sm text-gray-900 col-span-2">@Model.Ticket.Category?.Name</dd>
                    </div>
                    <div class="py-3 grid grid-cols-3 gap-4">
                        <dt class="text-sm font-medium text-gray-500 col-span-1">Created</dt>
                        <dd class="text-sm text-gray-900 col-span-2">@Model.Ticket.CreatedAt</dd>
                    </div>
                    <div class="py-3 grid grid-cols-3 gap-4">
                        <dt class="text-sm font-medium text-gray-500 col-span-1">Last Updated</dt>
                        <dd class="text-sm text-gray-900 col-span-2">@Model.Ticket.UpdatedAt</dd>
                    </div>
                    <div class="py-3 grid grid-cols-3 gap-4">
                        <dt class="text-sm font-medium text-gray-500 col-span-1">Room</dt>
                        <dd class="text-sm text-gray-900 col-span-2">Science Wing - Room 204</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
    <div id="zoom-overlay"
             class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-sm flex justify-center items-center opacity-0 transition-opacity duration-300 ease-out"
             onclick="closeZoom()">
    
            <button class="absolute top-5 right-5 text-white text-4xl font-bold hover:text-gray-300 focus:outline-none" onclick="closeZoom()">&times;</button>
    
            <img id="zoomed-image"
                 src=""
                 alt="Zoomed Content"
                 class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl transform scale-95 transition-transform duration-300"
                 onclick="event.stopPropagation()"/>
        </div>
        
        @await Html.PartialAsync("_Footer")
</div> 
    
     
</div>

@section Scripts {
    <script src="~/js/libs/toast.js" asp-append-version="true"></script>
    <script src="~/js/admin/view-ticket.js" asp-append-version="true"></script>
}